    "event":  [
                  {
                      "script":  {
                                     "exec":  [
                                                  "if ([\u0027Login\u0027, \u0027Refresh\u0027, \u0027Logout\u0027].includes(pm.info.requestName)) {",
                                                  "  pm.sendRequest(pm.variables.get(\u0027baseUrl\u0027) + \u0027/api/v1/auth/csrf\u0027, (error, response) =\u003e {",
                                                  "    if (error || response.code !== 200) throw new Error(\u0027Cannot obtain CSRF token\u0027);",
                                                  "    pm.request.headers.upsert({ key: \u0027X-CSRF-TOKEN\u0027, value: response.json().token });",
                                                  "  });",
                                                  "}"
                                              ],
                                     "type":  "text/javascript"
                                 },
                      "listen":  "prerequest"
                  },
                  {
                      "script":  {
                                     "exec":  [
                                                  "if (pm.response.code === 200) {",
                                                  "  const body = pm.response.json();",
                                                  "  if (body.token \u0026\u0026 [\u0027Login\u0027, \u0027Refresh\u0027].includes(pm.info.requestName)) pm.collectionVariables.set(\u0027token\u0027, body.token);",
                                                  "  if (body.userId \u0026\u0026 pm.info.requestName === \u0027Register\u0027) pm.collectionVariables.set(\u0027userId\u0027, body.userId);",
                                                  "}",
                                                  "if (pm.info.requestName === \u0027Logout\u0027 \u0026\u0026 pm.response.code === 204) pm.collectionVariables.set(\u0027token\u0027, \u0027\u0027);"
                                              ],
                                     "type":  "text/javascript"
                                 },
                      "listen":  "test"
                  }
              ],

{
  "info": {
    "name": "DatingApp TV4 — ChatNotifications (DEV)",
    "description": "REST helper only. SignalR Hub SendMessage is tested with React / smoke script. Demo endpoints Development only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5080"
    },
    {
      "key": "conversationId",
      "value": "FILL_REAL_UUID"
    },
    {
      "key": "messageId",
      "value": "FILL_REAL_UUID"
    },
    {
      "key": "notificationId",
      "value": "FILL_REAL_UUID"
    }
  ],
  "item": [
    {
      "name": "01 - Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "health"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "02 - Get demo token A",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/dev/token/A",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "dev",
            "token",
            "A"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.response.code === 200) pm.environment.set(\"tokenA\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
